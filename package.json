{
  "scripts": {
    "css": "npx postcss src/css/*.css --dir dist/css",
    "clean": "rimraf dist && mkdir dist",
    "copy:html": "copyfiles -f src/index.html dist",
    "copy:models": "copyfiles -f public/models/* dist/models",
    "copy:js": "copyfiles -f src/js/*.js dist/js",
    "prebuild": "npm run clean",
    "build": "npm run copy:html && npm run copy:models && npm run copy:js && npm run css",
    "start": "npm run build && concurrently \"npx serve dist\" \"npm run css -- --watch\""
  },
  "dependencies": {
    "clean-css": "^5.3.2",
    "concurrently": "^8.2.2",
    "cssnano": "^6.0.1",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "postcss-import": "^15.1.0",
    "postcss-import-ext-glob": "^2.1.1",
    "postcss-js": "^4.0.1",
    "slugify": "^1.6.6",
    "tailwindcss": "^3.3.5",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@types/three": "^0.173.0",
    "copyfiles": "^2.4.1",
    "rimraf": "^5.0.5"
  }
}
